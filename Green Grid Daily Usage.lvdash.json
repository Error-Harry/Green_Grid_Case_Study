{
  "datasets": [
    {
      "name": "76e846b2",
      "displayName": "gold_daily_usage",
      "config": {
        "version": "1.1",
        "source": "databricksbootcamp.greeengridcasestudy.gold_daily_usage",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "84a0eed1",
      "displayName": "peak_vs_offpeak",
      "queryLines": [
        "   SELECT 'Peak (18:00–21:00)' AS rate_period, SUM(peak_bill) AS billed\n",
        "   FROM databricksbootcamp.greeengridcasestudy.gold_daily_usage\n",
        "   UNION ALL\n",
        "   SELECT 'Off-peak', SUM(offpeak_bill)\n",
        "   FROM databricksbootcamp.greeengridcasestudy.gold_daily_usage"
      ]
    },
    {
      "name": "d2764641",
      "displayName": "top10_meters",
      "queryLines": [
        "   SELECT meter_id, total_bill\n",
        "   FROM databricksbootcamp.greeengridcasestudy.gold_daily_usage\n",
        "   ORDER BY total_bill DESC\n",
        "   LIMIT 10"
      ]
    }
  ],
